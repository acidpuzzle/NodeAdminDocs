#: ../../source/location/location.rst:4 d84f4d92f5184cd1b968d46c7f3b581e
msgid ""
"*Локация* — это физическая или логическая сущность, которая занимает "
"определенное место в иерархическом дереве."
msgstr ""

#: ../../source/location/location.rst:6 95279affe95e4493af90e61b1dc7e403
